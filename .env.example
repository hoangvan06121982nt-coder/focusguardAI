# FocusGuardAI Environment Configurations

# Database Type: 'sqlite' or 'firestore'
DATABASE_TYPE=firestore

# Toggle for Firebase Emulator ('true' or 'false').
# Set to 'false' to connect directly to Firebase Cloud / Production services.
USE_EMULATOR=true

# Emulator Host Configs (Automatically populated if USE_EMULATOR=true, but can be customized)
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Production Firebase Project ID (Used when USE_EMULATOR=false)
GOOGLE_CLOUD_PROJECT=focusguard-ai
# Path to service account private key JSON file (Used when USE_EMULATOR=false)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
